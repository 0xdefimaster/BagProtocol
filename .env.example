# Supabase project settings — Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-only, NEVER expose to the client or prefix with
# NEXT_PUBLIC_. Used by API routes to write trades/points/leaderboard rows
# that a client must never be able to forge.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random 32+ byte secret used to sign the wallet-login session cookie (JWT).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Required by app/api/cron/settle-creator-rewards and
# app/api/cron/reconcile-creator-rewards (lib/server/require-cron-secret.ts).
# Checked as "Authorization: Bearer <CRON_SECRET>" on every cron invocation.
# Fails closed (503) if unset — never leaves these routes open by accident.
# Generate one with: openssl rand -base64 32
CRON_SECRET=replace-with-a-long-random-string

# --- Phase 4: Bag deployment (lib/blockchain/evm/) -------------------------
# All optional. Leaving a chain's RPC_URL/FACTORY_ADDRESS unset makes
# lib/server/deploy-bag.ts fall back to the mock adapter for that chain —
# safe default for local dev, CI, and any chain you haven't deployed
# BagFactory to yet. Never commit real values for these.

# Server-only. The wallet that signs `BagFactory.createBag()` transactions —
# must match whatever address BagFactory's `deployer` is currently set to
# (see contracts/BagFactory.sol's `setDeployer`). This is a service wallet,
# NOT any individual creator's own wallet.
DEPLOYER_PRIVATE_KEY=0xyour-deployer-wallet-private-key

RPC_URL_ETHEREUM=https://your-ethereum-rpc-provider
FACTORY_ADDRESS_ETHEREUM=0xdeployed-bagfactory-address-on-ethereum
EXPLORER_URL_ETHEREUM=https://etherscan.io

RPC_URL_BASE=https://your-base-rpc-provider
FACTORY_ADDRESS_BASE=0xdeployed-bagfactory-address-on-base
EXPLORER_URL_BASE=https://basescan.org

RPC_URL_ARBITRUM=https://your-arbitrum-rpc-provider
FACTORY_ADDRESS_ARBITRUM=0xdeployed-bagfactory-address-on-arbitrum
EXPLORER_URL_ARBITRUM=https://arbiscan.io

# --- Phase 14: LI.FI live quote adapter (lib/blockchain/lifi-execution-adapter.ts) ---
# Both optional for THIS path. LIFI_INTEGRATOR defaults to "bag-protocol" if
# unset. LIFI_API_KEY is optional for /v1/quote (higher rate limits with a
# key — register at https://portal.li.fi/). Server-only — never prefix with
# NEXT_PUBLIC_, never referenced from client code.
#
# BUT: lib/blockchain/lifi-composer-adapter.ts (single-signature same-chain
# multi-asset purchase, see V13_DURUM_RAPORU.md section K) REQUIRES this key
# — verified against the installed @lifi/composer-sdk package itself, not
# assumed: createComposeSdk() throws "apiKey is required" if this is unset
# or blank. If the Composer path is wired into the purchase flow, this stops
# being optional the moment that code path is reachable.
LIFI_INTEGRATOR=bag-protocol
LIFI_API_KEY=

# --- Phase 17: real wallet + LI.FI execution (browser-side) ---
# Optional. Client-side integrator name shown to LI.FI/wallets during
# execution — separate from LIFI_INTEGRATOR above because this one is
# bundled into the browser (NEXT_PUBLIC_*), never LIFI_API_KEY (that stays
# server-only, see lib/blockchain/lifi-config.ts).
NEXT_PUBLIC_LIFI_INTEGRATOR=bag-protocol

# --- Phase 18: Real Price Authority (lib/domain/basket-protocol/pricing/coingecko-provider.ts) ---
# Optional. Without a key, the free/rate-limited CoinGecko endpoint is used
# (fine for low volume). Server-only — never prefix with NEXT_PUBLIC_.
COINGECKO_API_KEY=

# Test/local-only escape hatch — NEVER set this in a deployed environment.
# lib/server/price-provider.ts throws at startup if this is "mock" AND
# NODE_ENV=production, so a misconfigured deploy fails loudly instead of
# quietly pricing real purchases off MockPriceProvider.
PRICE_PROVIDER=

# --- Creator Rewards Vault (contracts/CreatorRewardsVault.sol, contracts/RedeemFeeRouter.sol) ---
# Production settlement chain is Robinhood Chain ONLY (chain id 4663) — see
# lib/config/robinhood-chain.ts, which is the single source of truth for
# the chain id / RPC / reward token address and refuses to be overridden
# per-network the way the multi-chain BagFactory config above is. Do not
# add a second reward token or a second settlement chain here.

# Server-only, ONE-TIME USE. The wallet that broadcasts
# scripts/deploy-creator-rewards.ts's deployment transactions. Does not need
# to be, and should not remain, a privileged role afterwards — the deployed
# contracts' `owner`/settler roles are configured separately (see below) and
# do not have to match the deploying key.
CREATOR_REWARDS_DEPLOYER_PRIVATE_KEY=0xyour-one-time-deployer-private-key

# Server-only. Deploy-time owner of CreatorRewardsVault / RedeemFeeRouter.
# MUST be a multisig in production, never a hot EOA — see contract NatSpec.
CREATOR_REWARDS_OWNER_ADDRESS=0xyour-multisig-address

# The settlement worker's wallet (lib/server/creator-rewards-settlement.ts).
# Added as a vault settler via CreatorRewardsVault.setSettler at deploy time.
# Must hold an ERC-20 approval on the reward token to the vault for at least
# as much as it will ever settle in one batch. Holds no special withdrawal
# right of its own — see contract NatSpec.
CREATOR_REWARDS_SETTLEMENT_WALLET_ADDRESS=0xyour-settlement-worker-address
# Server-only — the above wallet's private key, used by the settlement
# worker process itself (not by the deploy script).
CREATOR_REWARDS_SETTLEMENT_PRIVATE_KEY=0xyour-settlement-worker-private-key

# The address that signs EIP-712 fee attestations for RedeemFeeRouter —
# proves a given (redemptionId, feeAmount, creator) triple was actually
# computed by our backend from real cost-basis data, not supplied by a
# possibly-malicious frontend. Configured on RedeemFeeRouter at deploy time.
REDEEM_FEE_ATTESTOR_ADDRESS=0xyour-fee-attestor-address
# Server-only — the above address's private key, used by the API route that
# signs attestations (not by the deploy script). Rotate both together via
# RedeemFeeRouter.setFeeAttestor if ever suspected compromised.
REDEEM_FEE_ATTESTOR_PRIVATE_KEY=0xyour-fee-attestor-private-key

# Filled in only after real deployment (see scripts/deploy-creator-rewards.ts).
# lib/config/robinhood-chain.ts's DEPLOYED_CONTRACTS reads these at runtime;
# leaving them unset makes any code path that needs them fail closed rather
# than silently using a placeholder/guessed address.
CREATOR_REWARDS_VAULT_ADDRESS=
REDEEM_FEE_ROUTER_ADDRESS=

# Client-side (browser) copy of the vault address, read by
# hooks/useCreatorRewards.ts / lib/blockchain/creator-rewards-vault-client.ts
# to show a creator's live claimable balance and let them call `withdrawAll`
# directly from their own wallet. Safe to expose publicly — it's a contract
# address, not a secret. Leave unset to hide the on-chain claim UI entirely
# (falls back to the existing Supabase-ledger-only display).
NEXT_PUBLIC_CREATOR_REWARDS_VAULT_ADDRESS=

# NOT YET SET ANYWHERE — see lib/config/robinhood-chain.ts's module doc.
# No canonical Uniswap deployment address for Robinhood Chain has been
# independently verified from Uniswap's own deployment registry. Required
# before scripts/deploy-creator-rewards.ts can allowlist a real swap target
# on RedeemFeeRouter.
ROBINHOOD_UNISWAP_SWAP_TARGET_ADDRESS=

# --- Phase 19.X: BagExecutionRouter / RobinhoodUniswapProvider (purchase path) ---
# Both optional, together — same "no key, never attempted" rule as
# LIFI_API_KEY above. Unset (either one) means `BagRouterProvider` is never
# registered in lib/execution/registry.ts and purchase-execution.ts falls
# straight through to LI.FI Composer / sequential exactly as before this
# phase existed. Do NOT set only one of the two — a router address with no
# signer (or vice versa) leaves the provider half-configured; the code
# checks for both together (lib/server/purchase-execution.ts's
# buildBagRouterProviderConfig()) and just omits the provider if either is
# missing, so this is a "won't crash, just won't route through BAG's own
# router" state, not a hard failure — but it means a deploy is silently NOT
# using the router you may think it is.

# Server-only. `contracts/BagExecutionRouter.sol`'s deployed address on
# Robinhood Chain (chainId 4663 — see lib/config/robinhood-chain.ts).
# BEFORE setting this: the deployed router's owner MUST have already called
# setTargetAllowlist(UNISWAP_ROUTER_ADDRESS, true) and setTokenAllowlist(...)
# for every canonical asset this Bag protocol trades — the router accepts
# NOTHING by default. This env var does not deploy or configure anything;
# it only tells this app where an ALREADY-deployed, ALREADY-allowlisted
# router lives.
BAG_EXECUTION_ROUTER_ADDRESS=

# Server-only. Private key for the wallet configured as the deployed
# router's `planSigner` (see BagExecutionRouter.sol's constructor / the
# owner-only `setPlanSigner`). This key signs the EIP-712 `ExecutionPlan`
# struct server-side (lib/blockchain/bag-execution-router-signer.ts) — it
# never reaches the browser and is not the same key as any user's wallet.
# A mismatch between this key's address and the router's on-chain
# `planSigner` fails closed on-chain (InvalidPlanSignature), never silently.
# Rotate both together via setPlanSigner if ever suspected compromised.
BAG_ROUTER_PLAN_SIGNER_KEY=0xyour-plan-signer-private-key

